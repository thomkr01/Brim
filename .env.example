# Copy to .env and fill in. Keep .env out of git (it is in .gitignore).

# Discord application (Developer Portal > your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URL of the dashboard. Use http://localhost:8080 locally.
# Add <DASHBOARD_URL>/auth/callback as an OAuth2 redirect in the portal.
DASHBOARD_URL=http://localhost:8080
# Optional: link behind the Support buttons (welcome message and dashboard wizard).
# SUPPORT_URL=https://discord.gg/your-invite
# Host port for the dashboard in docker compose (bound to 127.0.0.1).
DASHBOARD_PORT=8080
# Server only, see DEPLOY.md: Cloudflare Tunnel token and the profile that starts it.
# TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# Server only, see DEPLOY.md: read-only AI connector (MCP server). Add mcp to COMPOSE_PROFILES (e.g. tunnel,mcp).
# MCP_DB_PASSWORD: letters and digits only. An MCP client with a token logs in with a token from the dashboard's MCP tokens page (DEPLOY.md 6.4).
# MCP_DB_PASSWORD=
# Login of an OAuth MCP client through Discord, read only; off until all three are set.
# MCP_OAUTH_SECRET: at least 32 characters; changing it logs every OAuth client out. MCP_OWNER_ID: your Discord user id.
# MCP_OAUTH_SECRET=
# MCP_PUBLIC_URL=https://mcp.example.com
# MCP_OWNER_ID=
# MCP_OAUTH_REDIRECTS: comma-separated exact https callback URLs of your OAuth MCP client, e.g. https://client.example.com/oauth/callback. Empty: no https callback is accepted.
# MCP_OAUTH_REDIRECTS=

# Server only: image tag to run (default latest). Set a sha to roll back, see DEPLOY.md. (The old name
# TOMMYBOT_TAG still works.)
# BRIM_TAG=latest
# Server only: rclone remote for scripts/backup.sh uploads, see DEPLOY.md. Unset = local backups only.
# RCLONE_REMOTE=b2:brim-backups
# Server only: age public key every scripts/backup.sh copy is encrypted to (DEPLOY.md section 8).
# BACKUP_AGE_RECIPIENT=age1...

# Web verification: Cloudflare Turnstile keys (dash.cloudflare.com > Turnstile).
# Without them Web mode only asks the member to sign in.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Docker only: this .env is for the Brim names (compose project brim, database brim, volumes brim_*).
# docker compose refuses to start without it, so a server set up before the rename to Brim cannot
# start on new, empty volumes by a git pull. Such a server keeps its old compose file until its move.
BRIM_NAMES=1
# Docker only: password for the bundled Postgres. Use letters and digits, since it goes into a URL.
POSTGRES_PASSWORD=
# Docker only: password of the dashboard's own database role (not a superuser). Letters and digits.
# Make it on the server: printf '\nDASHBOARD_DB_PASSWORD=%s\n' "$(openssl rand -hex 24)" >> .env (DEPLOY.md "Dashboard database role").
DASHBOARD_DB_PASSWORD=

# Running without Docker: full connection string. Compose builds its own from POSTGRES_PASSWORD.
# DATABASE_URL=postgres://brim:password@localhost:5432/brim

# Optional. Default is info. Use debug or brim=debug to see more.
# RUST_LOG=info

# Running without Docker, optional. Dashboard bind address and built UI folder.
# BIND=127.0.0.1:8080
# DASHBOARD_DIST=crates/dashboard/ui/dist

# Running without Docker, optional: Prometheus metrics from the bot, off when unset. No auth, keep it
# on localhost or a private network. docker-compose.yml does not pass it (no port is published).
# METRICS_ADDR=127.0.0.1:9100

# Optional: domain lists of the phishing and NSFW link filters. Unset uses the built-in source; set
# but empty turns that list off.
# PHISHING_LIST_URL=
# NSFW_LIST_URL=
# Optional: CPU threads for the NSFW image scan, 1 to 8 (default 1).
# NSFW_THREADS=1

# Discord REST base URL; only the e2e run (tests/e2e) changes it.
# DISCORD_API_BASE=https://discord.com/api/v10

# Set by docker-compose.yml or the image, not here: LOG_DIR (where the bot and dashboard also write
# log files), LOG_READ_DIR (where the MCP server reads them), BRIM_SHA (the running commit) and
# DASHBOARD_INTERNAL_URL (how the MCP server reaches the dashboard).
